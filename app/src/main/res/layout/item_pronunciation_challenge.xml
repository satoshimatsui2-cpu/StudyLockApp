<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/app_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/text_word"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/text_main"
            tools:text="different" />

        <TextView
            android:id="@+id/text_meaning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:textSize="18sp"
            android:textColor="@color/text_sub"
            tools:text="異なる" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/app_outline"
            android:layout_marginVertical="24dp" />

        <!-- Word Pronounce Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="単語の発音"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/navy_primary" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_listen_word"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="お手本を聞く"
                android:textSize="12sp"
                app:icon="@drawable/ic_volume_up_24"
                app:iconSize="18dp"
                android:minHeight="0dp"
                android:padding="4dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pronounce_word"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:layout_marginTop="8dp"
            android:text="単語を発音する"
            android:textSize="18sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_mic_24"
            app:iconGravity="textStart"
            app:iconSize="28dp"
            app:iconPadding="12dp"
            app:strokeWidth="0dp" />

        <TextView
            android:id="@+id/text_word_recognition_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="8dp"
            android:background="#10000000"
            android:textSize="15sp"
            android:textColor="@color/text_main"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="認識結果: diffrent (不一致)" />

        <!-- Sentence Pronounce Section -->
        <LinearLayout
            android:id="@+id/layout_sentence_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal"
            android:gravity="bottom">
            <TextView
                android:id="@+id/label_sentence"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="例文の発音"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/navy_primary" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_listen_sentence"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="お手本を聞く"
                android:textSize="13sp"
                app:icon="@drawable/ic_volume_up_24"
                app:iconSize="20dp"
                android:minHeight="0dp"
                android:padding="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_sentence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            android:background="#08000000"
            android:textSize="17sp"
            android:textColor="@color/text_main"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="This is a different story." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pronounce_sentence"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:layout_marginTop="8dp"
            android:text="例文を発音する"
            android:textSize="18sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_mic_24"
            app:iconGravity="textStart"
            app:iconSize="28dp"
            app:iconPadding="12dp"
            app:strokeWidth="0dp" />

        <TextView
            android:id="@+id/text_sentence_recognition_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="8dp"
            android:background="#10000000"
            android:textSize="15sp"
            android:textColor="@color/text_main"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="認識結果: This is a diffrent story. (不一致)" />

        <TextView
            android:id="@+id/text_lock_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/pronunciation_example_locked"
            android:textColor="@color/choice_wrong_text"
            android:textSize="12sp"
            android:gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_unlock_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="例文が解放されました！"
            android:textColor="@color/choice_correct_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
