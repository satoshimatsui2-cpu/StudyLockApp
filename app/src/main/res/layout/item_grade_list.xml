<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_grade_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/app_outline"
    app:cardBackgroundColor="@color/white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <TextView
            android:id="@+id/text_grade_name"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:textColor="@color/navy_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="準2級" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical|end">

            <!-- トータル単語数 -->
            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_book_24"
                app:tint="@color/text_sub"
                android:contentDescription="全単語数" />
            <TextView
                android:id="@+id/text_count_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/text_main"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="1000語" />

            <!-- 短期マスター -->
            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/ic_round_stars_24"
                app:tint="@color/mustard_soft"
                android:contentDescription="短期マスター" />
            <TextView
                android:id="@+id/text_count_basic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:textColor="@color/text_main"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="120 (85%)" />

            <!-- 長期マスター -->
            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/ic_mastery_diamond_24"
                app:tint="#B0BEC5"
                android:contentDescription="長期マスター" />
            <TextView
                android:id="@+id/text_count_longterm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:textColor="@color/text_main"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="45 (15%)" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
