<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:padding="16dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 1. Mastery Journey Card (Header) -->
    <include
        android:id="@+id/layout_journey_header"
        layout="@layout/layout_journey_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. Session Progress Bar -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:indicatorColor="@color/text_sub"
        app:layout_constraintEnd_toStartOf="@+id/text_progress_percent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_journey_header"
        app:trackColor="@color/app_outline"
        app:trackThickness="2dp" />

    <TextView
        android:id="@+id/text_progress_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/text_sub"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="@+id/progress_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/progress_horizontal"
        tools:text="4 / 10" />

    <!-- 3. Main Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/layout_assist_buttons"
        app:layout_constraintTop_toBottomOf="@id/progress_horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_question"
            style="@style/Widget.Material3.CardView.Elevated"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp">

                <TextView
                    android:id="@+id/text_question_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_sub"
                    android:textSize="18sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_question_grade_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/navy_soft"
                    app:cardCornerRadius="6dp"
                    app:strokeWidth="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/text_question_title">
                    <TextView
                        android:id="@+id/text_question_grade_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/navy_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="4級" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/text_question_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="@color/text_main"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/card_question_grade_badge" />

                <!-- Sentence Sorting UI -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_sort_container"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toTopOf="@id/choices_container"
                    app:layout_constraintTop_toBottomOf="@id/text_question_body">

                    <com.google.android.flexbox.FlexboxLayout
                        android:id="@+id/flexbox_answer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/shape_answer_area"
                        android:minHeight="120dp"
                        android:padding="8dp"
                        app:flexWrap="wrap"
                        app:justifyContent="flex_start"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.flexbox.FlexboxLayout
                        android:id="@+id/flexbox_candidates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        app:flexWrap="wrap"
                        app:justifyContent="center"
                        app:layout_constraintTop_toBottomOf="@id/flexbox_answer" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_sort_check"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="判定する"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:id="@+id/choices_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <FrameLayout
                        android:id="@+id/choice_buttons_frame"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/choice_buttons_inner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_choice_1"
                                style="@style/Widget.StudyLock.ChoiceButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_choice_2"
                                style="@style/Widget.StudyLock.ChoiceButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_choice_3"
                                style="@style/Widget.StudyLock.ChoiceButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_choice_4"
                                style="@style/Widget.StudyLock.ChoiceButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp" />
                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/choice_cover_card"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            app:cardBackgroundColor="@color/choice_cover_bg"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="4dp"
                            app:strokeColor="@color/choice_cover_stroke"
                            app:strokeWidth="2dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <TextView
                                    android:id="@+id/text_reveal_message"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="まず自分で思い出してみよう"
                                    android:textColor="@color/choice_cover_text"
                                    android:textSize="13sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/button_reveal_choices"
                                    style="@style/Widget.Material3.Button"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="16dp"
                                    android:minHeight="60dp"
                                    android:paddingHorizontal="40dp"
                                    android:text="回答する"
                                    android:textColor="@color/white"
                                    android:textSize="16sp"
                                    app:backgroundTint="@color/choice_cover_bg"
                                    app:icon="@drawable/ic_lightbulb_24"
                                    app:iconPadding="12dp"
                                    app:iconTint="@color/white"
                                    app:strokeColor="@color/white"
                                    app:strokeWidth="2dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </FrameLayout>

                    <!-- 回答補助ボタン (わからない・再生) -->
                    <LinearLayout
                        android:id="@+id/layout_answer_assist_buttons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_unknown_answer"
                            style="@style/Widget.StudyLock.AssistButton.Unknown"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="@string/action_unknown_answer" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_replay_question_audio"
                            style="@style/Widget.StudyLock.AssistButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.4"
                            android:contentDescription="@string/cd_replay_question_audio"
                            app:icon="@drawable/ic_volume_up_24"
                            app:iconPadding="0dp"
                            app:iconGravity="textStart" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <include
            android:id="@+id/layout_review_card"
            layout="@layout/layout_review_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/layout_flying_levelup"
            layout="@layout/layout_flying_levelup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Reward Popup -->
    <TextView
        android:id="@+id/text_reward_popup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="32dp"
        android:alpha="0"
        android:background="@drawable/shape_reward_pill"
        android:elevation="10dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="@color/navy_dark"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="+10pt"
        tools:visibility="visible" />

    <!-- 補助操作 学習補助パネル (チップ列) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_assist_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="#F1F3F6"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|start"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_sound_settings_assist"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="8dp"
                android:text="@string/label_sound_settings"
                android:textSize="11sp"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_settings"
                app:iconSize="16dp"
                app:iconPadding="4dp"
                app:iconGravity="textStart"
                app:strokeWidth="1dp"
                android:contentDescription="@string/cd_sound_settings" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_toggle_choices"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="8dp"
                android:text="@string/action_toggle_choices"
                android:textSize="11sp"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_visibility_24"
                app:iconSize="16dp"
                app:iconPadding="4dp"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_toggle_other_grade_reviews"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="8dp"
                android:text="@string/label_other_grade_off"
                android:textSize="11sp"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_review_24"
                app:iconSize="16dp"
                app:iconPadding="4dp"
                app:strokeWidth="1dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
