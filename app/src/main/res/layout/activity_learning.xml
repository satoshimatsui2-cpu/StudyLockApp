<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_surface"
    android:padding="16dp">

    <!-- 1. Mastery Journey Card (整理されたカードUI) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_mastery_journey"
        style="@style/Widget.Material3.CardView.Elevated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- 補助情報: 目標レベル -->
            <TextView
                android:id="@+id/text_target_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/md_onSurface_muted"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="目標: 準2級" />

            <!-- 補助情報: 獲得ポイント -->
            <TextView
                android:id="@+id/text_session_points_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/md_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="120 PT" />

            <!-- 主役: 現在の単語レベル (級) -->
            <TextView
                android:id="@+id/text_word_grade_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/md_onSurface"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_target_level"
                tools:text="4級 を学習中" />

            <!-- 習得LVのタイトル (基礎マスターまで 等) -->
            <TextView
                android:id="@+id/text_journey_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_word_grade_label"
                tools:text="基礎マスターまで" />

            <!-- 習得LVチップ -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_current_level"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:textColor="@color/md_onSurface"
                android:textSize="12sp"
                android:textStyle="bold"
                app:chipBackgroundColor="@color/mastery_bg_learning"
                app:chipCornerRadius="16dp"
                app:chipStrokeWidth="0dp"
                app:layout_constraintBottom_toBottomOf="@id/text_journey_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/text_journey_title"
                tools:text="LV 4" />

            <!-- 進捗バー -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_mastery_rail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:indicatorColor="@color/md_primary"
                app:layout_constraintTop_toBottomOf="@id/text_journey_title"
                app:trackColor="@color/md_outline"
                app:trackCornerRadius="5dp"
                app:trackThickness="10dp" />

            <!-- サブ文言 -->
            <TextView
                android:id="@+id/text_journey_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/md_onSurface_muted"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/progress_mastery_rail"
                tools:text="あと1段階で昇格" />

            <!-- マスター統計サマリー -->
            <TextView
                android:id="@+id/text_mastery_stats_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/md_onSurface_muted"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="@id/text_journey_subtitle"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="基礎:12 / 長期:3" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 2. セッション進捗バー (薄い) -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:indicatorColor="@color/md_secondary"
        app:layout_constraintEnd_toStartOf="@+id/text_progress_percent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_mastery_journey"
        app:trackColor="@color/md_outline"
        app:trackThickness="2dp" />

    <TextView
        android:id="@+id/text_progress_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/md_onSurface_muted"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="@+id/progress_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/progress_horizontal"
        tools:text="4 / 10" />

    <!-- 3. メインコンテナ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_actions"
        app:layout_constraintTop_toBottomOf="@id/progress_horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_question"
            style="@style/Widget.Material3.CardView.Elevated"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp">

                <TextView
                    android:id="@+id/text_question_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/text_question_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="@color/md_onSurface"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/text_question_title" />

                <TextView
                    android:id="@+id/text_reward_popup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:alpha="0"
                    android:background="@drawable/shape_reward_pill"
                    android:elevation="6dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/choices_container"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:alpha="1"
                    tools:text="+10 PT" />

                <LinearLayout
                    android:id="@+id/choices_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_choice_1"
                        style="@style/Widget.StudyLock.ChoiceButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_choice_2"
                        style="@style/Widget.StudyLock.ChoiceButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_choice_3"
                        style="@style/Widget.StudyLock.ChoiceButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_choice_4"
                        style="@style/Widget.StudyLock.ChoiceButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Answer Review Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_answer_review"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp">

                <TextView
                    android:id="@+id/text_review_word"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/md_onSurface"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="persistent" />

                <TextView
                    android:id="@+id/text_review_phonetic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="@id/text_review_word"
                    app:layout_constraintStart_toEndOf="@id/text_review_word"
                    tools:text="/pərˈsɪstənt/" />

                <ImageButton
                    android:id="@+id/button_play_review_word"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="発音を再生"
                    android:src="@drawable/ic_volume_up_24"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/divider_review"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/md_outline"
                    app:layout_constraintTop_toBottomOf="@id/text_review_word" />

                <TextView
                    android:id="@+id/text_review_sentence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/md_onSurface"
                    android:textSize="16sp"
                    app:layout_constraintTop_toBottomOf="@id/divider_review"
                    tools:text="She was persistent in her efforts." />

                <TextView
                    android:id="@+id/text_review_sentence_jp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/md_onSurface_muted"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@id/text_review_sentence"
                    tools:text="彼女は粘り強く努力した。" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_play_review_sentence"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/action_play_example"
                    app:icon="@drawable/ic_volume_up_24"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/text_review_sentence_jp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_next_question"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/action_go_next"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- 4. 下部アクション -->
    <LinearLayout
        android:id="@+id/layout_bottom_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_toggle_auto_play"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:textColor="@color/md_onSurface_muted"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="自動再生 ON" />

        <ImageButton
            android:id="@+id/button_toggle_audio_mode"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="音声モード切替"
            android:src="@drawable/ic_volume_up_24" />

        <TextView
            android:id="@+id/text_audio_mode_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/md_onSurface_muted"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_admin_settings"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_admin_settings"
            android:textColor="@color/md_onSurface_muted"
            app:icon="@drawable/ic_settings" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
