<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:padding="16dp">

    <!-- 1. Mastery Journey Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_mastery_journey"
        style="@style/Widget.Material3.CardView.Elevated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/text_target_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_sub"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="目標: 準2級" />

            <TextView
                android:id="@+id/text_session_points_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/navy_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="120 PT" />

            <TextView
                android:id="@+id/text_word_grade_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_main"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_target_level"
                tools:text="4級 を学習中" />

            <TextView
                android:id="@+id/text_journey_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/navy_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_word_grade_label"
                tools:text="基礎マスターまで" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_current_level"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:textColor="@color/text_main"
                android:textSize="12sp"
                android:textStyle="bold"
                app:chipBackgroundColor="@color/navy_soft"
                app:chipCornerRadius="16dp"
                app:chipStrokeWidth="0dp"
                app:layout_constraintBottom_toBottomOf="@id/text_journey_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/text_journey_title"
                tools:text="LV 4" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_mastery_rail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:indicatorColor="@color/mustard_accent"
                app:layout_constraintTop_toBottomOf="@id/text_journey_title"
                app:trackColor="@color/navy_soft"
                app:trackCornerRadius="5dp"
                app:trackThickness="10dp" />

            <TextView
                android:id="@+id/text_journey_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_sub"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/progress_mastery_rail"
                tools:text="あと1段階で昇格" />

            <TextView
                android:id="@+id/text_mastery_stats_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_sub"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="@id/text_journey_subtitle"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="基礎:12 / 長期:3" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 2. セッション進捗バー -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:indicatorColor="@color/text_sub"
        app:layout_constraintEnd_toStartOf="@+id/text_progress_percent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_mastery_journey"
        app:trackColor="@color/app_outline"
        app:trackThickness="2dp" />

    <TextView
        android:id="@+id/text_progress_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/text_sub"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="@+id/progress_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/progress_horizontal"
        tools:text="4 / 10" />

    <!-- 3. メインコンテナ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_actions"
        app:layout_constraintTop_toBottomOf="@id/progress_horizontal">

        <!-- クイズカード -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_question"
            style="@style/Widget.Material3.CardView.Elevated"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp">

                <TextView
                    android:id="@+id/text_question_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_sub"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/text_question_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="@color/text_main"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/text_question_title" />

                <LinearLayout
                    android:id="@+id/choices_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_choice_1"
                        style="@style/Widget.StudyLock.ChoiceButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_choice_2"
                        style="@style/Widget.StudyLock.ChoiceButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_choice_3"
                        style="@style/Widget.StudyLock.ChoiceButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_choice_4"
                        style="@style/Widget.StudyLock.ChoiceButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- レビューカード -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_answer_review"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp">

                <!-- 1. モードと問題 -->
                <TextView
                    android:id="@+id/text_review_mode_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="英語 → 日本語" />

                <TextView
                    android:id="@+id/text_review_question_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_main"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/text_review_mode_label"
                    tools:text="persistent" />

                <!-- 2. 答え合わせ -->
                <TextView
                    android:id="@+id/text_review_answer_wrong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/text_sub"
                    android:textSize="15sp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/text_review_question_text"
                    tools:text="✕ あなたの回答: 永続的な"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/text_review_answer_correct"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/choice_correct"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/text_review_answer_wrong"
                    tools:text="○ 正解: 持続する" />

                <!-- 3. 聞き比べセクション (LISTEN_EN 不正解時) -->
                <LinearLayout
                    android:id="@+id/layout_listening_compare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/app_background"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/text_review_answer_correct"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="聞き比べ"
                        android:textColor="@color/text_sub"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <!-- 誤答 -->
                        <LinearLayout
                            android:id="@+id/layout_wrong_word_detail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/text_compare_wrong_word"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_main"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="assistant" />
                            <TextView
                                android:id="@+id/text_compare_wrong_phonetic"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_sub"
                                android:textSize="11sp"
                                tools:text="/əˈsɪstənt/" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_play_compare_wrong"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="0dp"
                                android:padding="0dp"
                                app:icon="@drawable/ic_volume_up_24" />
                        </LinearLayout>

                        <!-- 正答 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/text_compare_correct_word"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_main"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="persistent" />
                            <TextView
                                android:id="@+id/text_compare_correct_phonetic"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_sub"
                                android:textSize="11sp"
                                tools:text="/pərˈsɪstənt/" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_play_compare_correct"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="0dp"
                                android:padding="0dp"
                                app:icon="@drawable/ic_volume_up_24" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 4. 詳細 (発音・例文) -->
                <View
                    android:id="@+id/divider_review"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/app_outline"
                    app:layout_constraintTop_toBottomOf="@id/layout_listening_compare" />

                <TextView
                    android:id="@+id/text_review_phonetic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/text_sub"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider_review"
                    tools:text="/pərˈsɪstənt/" />

                <ImageButton
                    android:id="@+id/button_play_review_word"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="発音を再生"
                    android:src="@drawable/ic_volume_up_24"
                    app:layout_constraintBottom_toBottomOf="@id/text_review_phonetic"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/text_review_phonetic" />

                <TextView
                    android:id="@+id/text_review_sentence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/text_main"
                    android:textSize="15sp"
                    app:layout_constraintTop_toBottomOf="@id/text_review_phonetic"
                    tools:text="She was persistent in her efforts to learn English." />

                <TextView
                    android:id="@+id/text_review_sentence_jp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"
                    app:layout_constraintTop_toBottomOf="@id/text_review_sentence"
                    tools:text="彼女は英語を学ぶために粘り強く努力した。" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_play_review_sentence"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/action_play_example"
                    app:icon="@drawable/ic_volume_up_24"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/text_review_sentence_jp" />

                <!-- 5. 次へ -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_next_question"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/action_go_next"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- 5. 報酬ポップアップ -->
    <TextView
        android:id="@+id/text_reward_popup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:alpha="0"
        android:background="@drawable/shape_reward_pill"
        android:elevation="10dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:textColor="@color/navy_dark"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/card_mastery_journey"
        app:layout_constraintTop_toTopOf="@id/card_mastery_journey" />

    <!-- 6. 下部アクション -->
    <LinearLayout
        android:id="@+id/layout_bottom_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 統合されたサイレントモード切替 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_toggle_silent_mode"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_sub"
            android:textSize="12sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_volume_up_24"
            tools:text="サイレントモード: OFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_admin_settings"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_admin_settings"
            android:textColor="@color/text_sub"
            app:icon="@drawable/ic_settings" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
