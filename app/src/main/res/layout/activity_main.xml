<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pattern_tile_repeat"
    android:clipChildren="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:paddingTop="50dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false">

                <!-- ヘッダー -->
                <LinearLayout
                    android:id="@+id/header_main"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginTop="40dp"
                    android:layout_marginBottom="8dp"
                    android:paddingTop="0dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <ImageView
                        android:id="@+id/title_top"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:src="@drawable/logo_title"
                        android:contentDescription="@string/app_name"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:scaleX="1.5"
                        android:scaleY="1.5"
                        android:maxWidth="780dp"
                        android:maxHeight="360dp"
                        android:elevation="20dp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <ImageView
                        android:id="@+id/image_character"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="80dp"
                        android:layout_marginBottom="40dp"
                        android:src="@drawable/logo_character"
                        android:contentDescription="@string/app_name"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:scaleX="1.5"
                        android:scaleY="1.5"
                        android:maxWidth="660dp"
                        android:maxHeight="420dp" />
                </LinearLayout>

                <!-- ポイントカード -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:orientation="horizontal"
                    android:weightSum="1"
                    android:gravity="center_horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_to_point_history"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.8"
                        android:layout_marginHorizontal="8dp"
                        app:cardUseCompatPadding="true"
                        app:cardElevation="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        app:strokeColor="@color/sl_button_stroke"
                        app:strokeWidth="3dp"
                        app:cardBackgroundColor="@color/white">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp">

                            <ImageView
                                android:id="@+id/icon_coin"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_monetization_on_24"
                                app:tint="@color/navy_primary"
                                android:contentDescription="@string/cd_coin"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center_horizontal"
                                app:layout_constraintStart_toEndOf="@id/icon_coin"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/arrow_icon"
                                android:layout_marginHorizontal="8dp">

                                <TextView
                                    android:id="@+id/text_points_top"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/points_default"
                                    android:textSize="18sp"
                                    android:textColor="@color/navy_primary"
                                    android:textStyle="bold"
                                    android:gravity="center_horizontal"
                                    tools:text="保有ポイント: 120" />

                                <TextView
                                    android:id="@+id/text_point_stats_top"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/point_stats_default"
                                    android:textSize="12sp"
                                    android:textColor="@color/navy_primary"
                                    android:paddingTop="6dp"
                                    android:gravity="center_horizontal"
                                    tools:text="今日: 30 / 前日比: +10" />
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/arrow_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_arrow_right"
                                app:tint="@color/navy_primary"
                                android:contentDescription="@string/cd_arrow_right"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent" />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- 履歴ボタン群 (1列縦並び) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginBottom="24dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_to_learning_history"
                        style="@style/App.MainButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="64dp"
                        android:text="@string/label_history_short"
                        app:icon="@drawable/ic_history_24"
                        app:iconGravity="textStart" />
                </LinearLayout>

                <!-- 目標・学習レベル表示 -->
                <TextView
                    android:id="@+id/text_target_grade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_horizontal"
                    android:textSize="14sp"
                    android:textColor="@color/navy_primary"
                    android:textStyle="bold"
                    tools:text="目標：3級 / 学習：5級（復習）" />

                <!-- 級選択ボタン -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="1"
                    android:gravity="center_horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/spinner_grade_top"
                        style="@style/App.MainButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.8"
                        android:layout_marginHorizontal="8dp"
                        android:text="@string/grade_3"
                        app:icon="@drawable/ic_expand_more"
                        app:iconGravity="textEnd"
                        app:iconSize="32dp" />
                </LinearLayout>

                <!-- STARTボタン -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="1"
                    android:layout_marginTop="10dp"
                    android:gravity="center_horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_to_learning"
                        style="@style/App.MainButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.8"
                        android:layout_marginTop="12dp"
                        android:layout_marginHorizontal="8dp"
                        android:text="@string/label_start_short"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_play_arrow_24"
                        app:iconGravity="textStart"
                        app:iconSize="28dp" />
                </LinearLayout>

                <!-- 管理設定ボタン (デバッグ用/非表示) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="1"
                    android:gravity="center_horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_admin_settings"
                        style="@style/App.MainButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.8"
                        android:layout_marginTop="10dp"
                        android:text="@string/action_admin_settings"
                        android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <ImageButton
            android:id="@+id/button_admin_settings_top"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_settings"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_admin_settings"
            android:clickable="true"
            android:focusable="true"
            android:elevation="8dp"
            app:tint="@color/navy_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="50dp"
            android:layout_marginEnd="16dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>