<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pattern_tile_repeat"
    android:clipChildren="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false">

                <!-- ヘッダーエリア (タイトル画像とスタンプの重なり) -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/header_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="156dp"
                    android:layout_marginBottom="4dp"
                    android:clipChildren="false">

                    <ImageView
                        android:id="@+id/title_top"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/logo_title"
                        android:contentDescription="@string/app_name"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:scaleX="1.62"
                        android:scaleY="1.62"
                        android:maxWidth="780dp"
                        android:maxHeight="360dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- 合格宣言スタンプ (タイトルの左上にオーバーレイ、さらに左上へ) -->
                    <LinearLayout
                        android:id="@+id/layout_goal_stamp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:rotation="-15"
                        android:background="@drawable/bg_stamp_border"
                        android:elevation="10dp"
                        app:layout_constraintTop_toTopOf="@id/title_top"
                        app:layout_constraintStart_toStartOf="@id/title_top"
                        android:layout_marginTop="-20dp"
                        android:layout_marginStart="-120dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="2dp">

                        <TextView
                            android:id="@+id/text_goal_prefix"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="目指せ 2級"
                            android:textColor="#E53935"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="目指せ 準1級" />

                        <TextView
                            android:id="@+id/text_goal_main"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="合格！"
                            android:textColor="#E53935"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/image_character"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="50dp"
                        android:layout_marginBottom="24dp"
                        android:src="@drawable/logo_character"
                        android:contentDescription="@string/app_name"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:scaleX="1.62"
                        android:scaleY="1.62"
                        android:maxWidth="660dp"
                        android:maxHeight="420dp"
                        app:layout_constraintTop_toBottomOf="@id/title_top"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- ミッションカード (画像との隙間を調整) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_mission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="27dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/app_outline"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- 1行目: 学習設定 (出題レベルと進捗) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="出題レベル"
                                    android:textColor="@color/text_main"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/button_select_grade"
                                    style="@style/Widget.Material3.Button"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:minHeight="48dp"
                                    android:paddingHorizontal="16dp"
                                    android:text="2級"
                                    android:textColor="@color/white"
                                    app:backgroundTint="@color/navy_primary"
                                    app:cornerRadius="24dp"
                                    app:icon="@drawable/ic_expand_more_24"
                                    app:iconGravity="textEnd"
                                    app:iconSize="20dp"
                                    app:iconTint="@color/white"
                                    app:rippleColor="#40FFFFFF" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/button_toggle_progress"
                                    style="@style/Widget.Material3.Button"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:minHeight="48dp"
                                    android:paddingHorizontal="16dp"
                                    android:text="@string/label_progress_detail"
                                    android:textColor="@color/white"
                                    app:backgroundTint="@color/navy_primary"
                                    app:cornerRadius="24dp"
                                    app:icon="@drawable/ic_expand_more_24"
                                    app:iconGravity="textEnd"
                                    app:iconSize="20dp"
                                    app:iconTint="@color/white"
                                    app:rippleColor="#40FFFFFF" />
                            </LinearLayout>

                            <!-- 進捗アコーディオン -->
                            <LinearLayout
                                android:id="@+id/layout_progress_accordion"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <include
                                    android:id="@+id/row_short_term"
                                    layout="@layout/layout_top_progress_row" />

                                <include
                                    android:id="@+id/row_long_term"
                                    layout="@layout/layout_top_progress_row" />

                                <include
                                    android:id="@+id/row_spelling"
                                    layout="@layout/layout_top_progress_row" />

                                <include
                                    android:id="@+id/row_word_pron"
                                    layout="@layout/layout_top_progress_row" />

                                <include
                                    android:id="@+id/row_sentence_pron"
                                    layout="@layout/layout_top_progress_row" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- 区切り線 -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/app_outline" />

                        <!-- 2行目: 今日のお題 -->
                        <LinearLayout
                            android:id="@+id/layout_daily_goals"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="今日のお題"
                                android:textSize="13sp"
                                android:textColor="@color/text_sub"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                <!-- 新規 (NEWチップに変更) -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_new_badge"
                                    android:text="NEW"
                                    android:textColor="@color/white"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:paddingHorizontal="4dp"
                                    android:paddingVertical="1dp" />
                                <TextView
                                    android:id="@+id/text_goal_new"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_marginEnd="12dp"
                                    android:text="3"
                                    android:textColor="@color/text_main"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:text="3" />

                                <!-- 復習 -->
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_review_24"
                                    app:tint="@color/navy_primary"
                                    android:contentDescription="復習" />
                                <TextView
                                    android:id="@+id/text_goal_review"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:textColor="@color/text_main"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:text="5" />
                                <TextView
                                    android:id="@+id/text_goal_review_total"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/text_sub"
                                    android:textSize="11sp"
                                    tools:text=" / 15" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- STARTボタン -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_to_learning"
                            style="@style/App.OrangeButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="@string/label_start_short"
                            android:textSize="18sp"
                            app:icon="@drawable/ic_play_arrow_24"
                            app:iconGravity="textStart"
                            app:iconSize="32dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_to_spelling_check"
                            style="@style/App.OrangeButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/action_spelling_check"
                            android:textSize="18sp"
                            app:icon="@drawable/ic_edit_24"
                            app:iconGravity="textStart"
                            app:iconSize="32dp"
                            android:contentDescription="@string/cd_spelling_check" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 最下段: ポイント・履歴 / フレンド・キャラ ボタン -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:layout_marginBottom="24dp"
                    android:layout_marginHorizontal="16dp"
                    android:orientation="vertical">

                    <!-- 1段目: ポイントと履歴 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_to_point_history"
                            style="@style/App.HistoryButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:minHeight="64dp"
                            android:text="ポイント"
                            android:textSize="12sp"
                            app:icon="@drawable/ic_monetization_on_24"
                            app:iconGravity="textStart" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_to_learning_history"
                            style="@style/App.HistoryButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:minHeight="64dp"
                            android:text="学習履歴"
                            android:textSize="12sp"
                            app:icon="@drawable/ic_history_24"
                            app:iconGravity="textStart" />
                    </LinearLayout>

                    <!-- 2段目: フレンドと応援キャラ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_to_friends"
                            style="@style/App.HistoryButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:minHeight="64dp"
                            android:text="フレンド"
                            android:textSize="12sp"
                            app:icon="@drawable/ic_link_24"
                            app:iconGravity="textStart" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_to_characters"
                            style="@style/App.HistoryButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:minHeight="64dp"
                            android:text="パートナー"
                            android:textSize="12sp"
                            app:icon="@drawable/ic_round_stars_24"
                            app:iconGravity="textStart" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 管理設定ボタン (デバッグ用/非表示) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="1"
                    android:gravity="center_horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_admin_settings"
                        style="@style/App.MainButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.8"
                        android:layout_marginTop="10dp"
                        android:text="@string/action_admin_settings"
                        android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- 管理者設定アイコン: 位置を少し下げる (36dp -> 42dp) -->
        <ImageButton
            android:id="@+id/button_admin_settings_top"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="9dp"
            android:src="@drawable/ic_settings"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_admin_settings"
            android:clickable="true"
            android:focusable="true"
            android:elevation="8dp"
            app:tint="@color/navy_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="56dp"
            android:layout_marginEnd="12dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
