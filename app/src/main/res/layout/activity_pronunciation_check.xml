<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.PronunciationCheckActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- 単語表示エリア (上部) -->
        <LinearLayout
            android:id="@+id/layoutWordInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/textWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#212121"
                android:textSize="44sp"
                android:textStyle="bold"
                tools:text="different" />

            <TextView
                android:id="@+id/textMeaning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#666666"
                android:textSize="22sp"
                tools:text="異なる、違った" />
        </LinearLayout>

        <!-- メイン操作ボタン群 (待機中/録音中) -->
        <LinearLayout
            android:id="@+id/layoutActionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutWordInfo"
            app:layout_constraintVertical_bias="0.85">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonListen"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginBottom="16dp"
                android:text="お手本を聞く"
                android:textSize="20sp"
                app:backgroundTint="#3F51B5"
                app:cornerRadius="16dp"
                app:icon="@android:drawable/ic_lock_silent_mode_off"
                app:iconSize="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonStartPronounce"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:text="発音する"
                android:textSize="20sp"
                app:backgroundTint="#E91E63"
                app:cornerRadius="16dp"
                app:icon="@android:drawable/ic_btn_speak_now"
                app:iconSize="32dp" />

            <TextView
                android:id="@+id/textInstruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAlignment="center"
                android:textColor="#757575"
                android:textSize="14sp"
                tools:text="ボタンを押して発音してください" />
        </LinearLayout>

        <!-- 結果表示カード -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutWordInfo"
            app:layout_constraintVertical_bias="0.8"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp">

                <TextView
                    android:id="@+id/textResultStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    tools:text="✅ 発音クリア！" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="聞き取り結果"
                    android:textColor="#9E9E9E"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/textRecognizedValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#212121"
                    android:textSize="24sp"
                    android:textStyle="italic"
                    tools:text="different" />

                <TextView
                    android:id="@+id/textResultMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:textAlignment="center"
                    android:textSize="16sp"
                    android:textColor="#424242"
                    android:textStyle="bold"
                    tools:text="🎉 単語OKバッジを獲得しました" />

                <LinearLayout
                    android:id="@+id/layoutResultButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:orientation="vertical">

                    <!-- お手本を聞く (失敗時メイン) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonResultListen"
                        style="@style/Widget.MaterialComponents.Button.Icon"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:text="お手本を聞く"
                        android:textSize="16sp"
                        app:cornerRadius="12dp"
                        app:icon="@android:drawable/ic_lock_silent_mode_off" />

                    <!-- もう一度発音する/もう一度試す (リトライ) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonRetry"
                        style="@style/Widget.MaterialComponents.Button.Icon"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="12dp"
                        android:text="もう一度発音する"
                        android:textSize="16sp"
                        app:cornerRadius="12dp"
                        app:icon="@android:drawable/ic_btn_speak_now" />

                    <!-- 戻る (成功時メイン) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonClose"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="12dp"
                        android:text="戻る"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
