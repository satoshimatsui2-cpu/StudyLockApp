<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:clipToPadding="false"
    android:fitsSystemWindows="true"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- タイトル（左にサウンドアイコン追加） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/navy_primary"
                android:contentDescription="@string/sound_settings_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sound_settings_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- 応援キャラ変更ボタン、友達と接続ボタンを削除 -->

        <!-- TTS Speed -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="14dp">

            <TextView
                android:id="@+id/text_tts_speed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/colorOnSurface"
                tools:text="発音スピード: 1.0" />

            <ImageButton
                android:id="@+id/reset_tts_speed"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_refresh_24"
                android:contentDescription="発音スピードをリセット"
                style="?attr/materialIconButtonStyle" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seek_tts_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="20" />

        <!-- TTS Pitch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="14dp">

            <TextView
                android:id="@+id/text_tts_pitch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/colorOnSurface"
                tools:text="声の高さ: 1.0" />

            <ImageButton
                android:id="@+id/reset_tts_pitch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_refresh_24"
                android:contentDescription="声の高さをリセット"
                style="?attr/materialIconButtonStyle" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seek_tts_pitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="20" />

        <!-- TTS Volume -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="14dp">

            <TextView
                android:id="@+id/text_tts_volume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/colorOnSurface"
                tools:text="発音音量: 100%" />

            <ImageButton
                android:id="@+id/reset_tts_volume"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_refresh_24"
                android:contentDescription="発音音量をリセット"
                style="?attr/materialIconButtonStyle" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seek_tts_volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="20" />

        <!-- 正解SE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="14dp">

            <TextView
                android:id="@+id/text_se_correct"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/colorOnSurface"
                tools:text="正解SE: 100%" />

            <ImageButton
                android:id="@+id/reset_se_correct"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_refresh_24"
                android:contentDescription="正解SEをリセット"
                style="?attr/materialIconButtonStyle" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seek_se_correct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="20" />

        <!-- 不正解SE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="14dp">

            <TextView
                android:id="@+id/text_se_wrong"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/colorOnSurface"
                tools:text="不正解SE: 100%" />

            <ImageButton
                android:id="@+id/reset_se_wrong"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_refresh_24"
                android:contentDescription="不正解SEをリセット"
                style="?attr/materialIconButtonStyle" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seek_se_wrong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="20" />

        <!-- 学習目標設定 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="32dp"
            android:padding="16dp"
            android:background="@drawable/bg_badge_navy_soft">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_round_stars_24"
                    app:tint="@color/navy_primary"
                    android:contentDescription="@string/target_sim_title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/target_sim_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/navy_primary" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/target_sim_label_new_words"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_target_minus"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="0dp"
                    android:text="-"
                    android:textSize="20sp"
                    app:cornerRadius="24dp" />

                <TextView
                    android:id="@+id/text_target_count"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/text_main"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="5" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_target_plus"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="0dp"
                    android:text="+"
                    android:textSize="20sp"
                    app:cornerRadius="24dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="@color/app_outline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/target_sim_load_estimate"
                android:textColor="@color/text_sub"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_sim_total_questions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                tools:text="・最大回答数: 約 75 問" />

            <TextView
                android:id="@+id/text_sim_total_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                tools:text="・学習時間: 約 19 分" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/target_sim_note"
                android:textColor="@color/text_sub"
                android:textSize="11sp" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/sound_settings_save"/>

    </LinearLayout>
</ScrollView>