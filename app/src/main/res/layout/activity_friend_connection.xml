<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_pattern_tile_repeat"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/navy_primary"
            android:contentDescription="戻る" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="友達と接続"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/navy_primary"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- 1. プロフィール統合エリア (名前・ID・QR) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_my_profile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/white"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_person_24"
                    android:padding="8dp"
                    android:background="@drawable/bg_circle_icon"
                    android:backgroundTint="@color/navy_soft"
                    app:tint="@color/navy_primary"
                    android:contentDescription="Profile Icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_my_name_display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/navy_primary"
                        tools:text="なまえ" />

                    <TextView
                        android:id="@+id/text_my_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="12sp"
                        android:textColor="@color/text_sub"
                        android:textIsSelectable="true"
                        tools:text="ID: ABC-123-XYZ" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_my_name"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="修正"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_edit_24"
                    app:iconSize="16dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/app_outline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_show_my_qr"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="自分のQRコードを表示"
                android:textColor="@color/navy_primary"
                app:strokeColor="@color/navy_primary"
                app:icon="@drawable/ic_qr_code_24"
                app:iconGravity="textStart" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 2. フレンド追加ボタン (コンパクト化) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_friend_main"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginBottom="24dp"
        android:text="フレンドを追加する"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_add_circle_24"
        app:iconSize="24dp"
        app:iconGravity="textStart" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="フレンドリスト"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_sub"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_friends"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>
