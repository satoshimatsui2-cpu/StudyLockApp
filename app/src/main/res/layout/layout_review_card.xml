<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_review_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="24dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_review_mode"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_sub"
                android:textSize="10sp"
                app:chipBackgroundColor="@color/app_background"
                app:chipIcon="@drawable/ic_headphones_24"
                app:chipIconSize="20dp"
                app:chipIconTint="@color/text_sub"
                app:chipStrokeWidth="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="リスニング" />

            <LinearLayout
                android:id="@+id/layout_review_question_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/chip_review_mode">

                <TextView
                    android:id="@+id/text_review_question_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_main"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="persistent" />

                <ImageButton
                    android:id="@+id/button_play_question_inline"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_volume_up_24"
                    android:visibility="gone"
                    app:tint="@color/navy_primary"
                    tools:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/layout_review_question_header">

                <LinearLayout
                    android:id="@+id/layout_result_wrong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/shape_result_card_wrong"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/review_label_your_answer"
                            android:textColor="@color/choice_wrong"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/text_review_answer_wrong"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_main"
                            android:textSize="15sp"
                            tools:text="永続的な" />
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/icon_play_wrong"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_volume_up_24"
                        app:tint="@color/choice_wrong"
                        android:visibility="gone"
                        tools:visibility="visible"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_result_correct"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_result_card_correct"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/review_label_correct_answer"
                            android:textColor="@color/choice_correct"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/text_review_answer_correct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_main"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="持続する" />
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/icon_play_correct"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_volume_up_24"
                        app:tint="@color/choice_correct"
                        android:visibility="gone"
                        tools:visibility="visible"
                        android:contentDescription="@null" />
                </LinearLayout>

                <!-- 惜しい不正解の説明 -->
                <LinearLayout
                    android:id="@+id/layout_synonym_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/shape_result_card_info"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone"
                    tools:visibility="visible">
                    <TextView
                        android:id="@+id/text_synonym_hint_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/navy_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="惜しい不正解" />
                    <TextView
                        android:id="@+id/text_synonym_hint_body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_main"
                        android:textSize="14sp"
                        tools:text="意味は近いが今回の正解ではない" />
                </LinearLayout>
            </LinearLayout>

            <!-- 削除予定/非表示の比較エリア -->
            <LinearLayout
                android:id="@+id/layout_listening_compare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/container_results">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_compare_arrows_24"
                        app:tint="@color/text_sub"
                        android:contentDescription="@null" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/review_label_compare"
                        android:textColor="@color/text_sub"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <include layout="@layout/item_compare_word" android:id="@+id/include_wrong" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" />
                    <include layout="@layout/item_compare_word" android:id="@+id/include_correct" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_word_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/layout_listening_compare">

                <!-- 発音記号 (表示される場合のみ) -->
                <LinearLayout
                    android:id="@+id/layout_review_phonetic_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_volume_up_24"
                        app:tint="@color/text_sub"
                        android:contentDescription="@null" />
                    <TextView
                        android:id="@+id/text_review_phonetic"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:textColor="@color/text_sub"
                        android:textSize="11sp"
                        tools:text="/pərˈsɪstənt/" />
                </LinearLayout>

                <!-- English Sentence -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="4dp"
                        android:src="@drawable/ic_chat_bubble_outline_24"
                        app:tint="@color/text_sub"
                        android:contentDescription="@null" />
                    <TextView
                        android:id="@+id/text_review_sentence"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:textColor="@color/text_main"
                        android:textSize="15sp"
                        tools:text="She was persistent in her efforts to learn English." />
                </LinearLayout>

                <!-- Japanese Translation & Play Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="top"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="4dp"
                        android:src="@drawable/ic_translate_24"
                        app:tint="@color/text_sub"
                        android:contentDescription="@null" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/text_review_sentence_jp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_sub"
                            android:textSize="13sp"
                            tools:text="彼女は英語を学ぶために粘り強く努力した。" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_play_review_sentence"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:layout_gravity="end"
                            android:minHeight="0dp"
                            android:padding="0dp"
                            android:text="再生"
                            android:textSize="15sp"
                            app:icon="@drawable/ic_volume_up_24"
                            app:iconSize="20dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 反対の意味 -->
                <LinearLayout
                    android:id="@+id/layout_antonyms_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="参考: 反対の意味"
                        android:textColor="@color/text_sub"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <LinearLayout
                        android:id="@+id/container_antonyms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_next_question"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:text="@string/action_go_next"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layout_word_info" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</com.google.android.material.card.MaterialCardView>
