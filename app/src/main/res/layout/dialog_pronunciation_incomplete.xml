<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardBackgroundColor="@color/dialog_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:strokeColor="@color/app_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/text_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="未クリアの単語があります"
            android:textColor="@color/navy_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/text_dialog_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/dialog_text_secondary"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/text_dialog_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="セッションを終了した場合、未クリアの単語は別のセッションで再出題されます。"
            android:textColor="@color/text_sub"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_continue"
            style="@style/App.OrangeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="未クリアを続ける"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_later"
            style="@style/Widget.StudyLock.AssistButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="セッションを終了" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>