<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <!-- キャラクター画像 - 横幅いっぱい(MAX)に拡大し、3:4の比率で全体を表示 -->
    <ImageView
        android:id="@+id/image_celebration_character"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/george_1"
        android:contentDescription="目標達成おめでとう！" />

    <!-- メッセージエリア - 画像の下に配置し、フォントサイズを微調整 -->
    <TextView
        android:id="@+id/text_celebration_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:paddingHorizontal="24dp"
        android:paddingVertical="20dp"
        android:textColor="@color/text_main"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/image_celebration_character"
        tools:text="おめでとう！目標達成だね！" />

    <!-- 終了ボタン - 下部に適切なマージンを配置 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_celebration_finish"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:text="やった！"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_celebration_message" />

</androidx.constraintlayout.widget.ConstraintLayout>
