<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <!-- キャラクター画像 - 本日の目標達成画面と同じ230dpに調整 -->
    <ImageView
        android:id="@+id/image_celebration_character"
        android:layout_width="230dp"
        android:layout_height="230dp"
        android:scaleType="fitCenter"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/mini_george_pleasure"
        android:contentDescription="目標達成おめでとう！" />

    <!-- 閉じるボタン (右上 X) -->
    <ImageButton
        android:id="@+id/button_celebration_close"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:src="@drawable/ic_close_24"
        app:tint="@color/text_sub"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="閉じる" />

    <!-- メッセージエリア - 画像の下に配置し、フォントサイズを微調整 -->
    <TextView
        android:id="@+id/text_celebration_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:paddingHorizontal="24dp"
        android:paddingVertical="20dp"
        android:textColor="@color/text_main"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/image_celebration_character"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="おめでとう！目標達成だね！" />

</androidx.constraintlayout.widget.ConstraintLayout>
