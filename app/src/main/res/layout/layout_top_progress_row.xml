<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/image_metric_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_history_24"
            app:tint="@color/navy_primary"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/text_metric_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="@color/text_main"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="短期" />

        <TextView
            android:id="@+id/text_metric_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_main"
            android:textSize="13sp"
            tools:text="120（48%）" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_metric"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:indicatorColor="@color/navy_primary"
        app:trackColor="#E0E0E0"
        app:trackCornerRadius="4dp"
        app:trackThickness="6dp"
        tools:progress="48" />

</LinearLayout>
