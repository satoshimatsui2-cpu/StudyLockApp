<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_scan_qr_option"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="QRコードを読み取る"
        app:icon="@drawable/ic_camera_24"
        app:iconGravity="textStart"
        app:cornerRadius="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginVertical="16dp">
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/app_outline" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="またはIDで追加" android:textSize="12sp" android:textColor="@color/text_sub" android:paddingHorizontal="8dp"/>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/app_outline" />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_friend_id_input"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundColor="@color/white"
        app:errorEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_friend_id_dialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="相手のIDを入力"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
