<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/privacy_policy_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="プライバシーポリシー"
            android:textColor="#212121"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#424242"
            android:text="EikenForSlacker（以下「本アプリ」）は、個人の学習習慣サポートおよび保護者による見守り対応を実現するため、以下の通りプライバシーポリシーを定めます。" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="1. 収集する情報と利用目的"
            android:textColor="#212121"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#424242"
            android:text="本アプリは、サービスの提供にあたり以下の情報を取得・利用します。\n\n・アカウント情報：Firebase Auth（匿名認証を含む）によるユーザー識別子。\n・学習データ：学習履歴、正誤情報、獲得・使用ポイント、習熟度、発音チェックの結果。\n・見守り情報：ペアリングされた親端末への学習進捗の共有。\n・デバイス情報：通知用トークン（FCM）、プッシュ通知の配信に使用。" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="2. AccessibilityService API の利用"
            android:textColor="#212121"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#424242"
            android:text="本アプリは、ユーザーが設定した利用制限を実行するためにアクセシビリティ権限を使用します。\n・目的：学習ポイント不足時のアプリ起動検知、および制限設定を守るためのシステム設定画面へのアクセス検知。\n・非収集情報：キーボード入力内容（パスワード、メッセージ本文等）、通話内容、会話履歴を収集・共有することは一切ありません。" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="3. マイク権限と音声データ"
            android:textColor="#212121"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#424242"
            android:text="・利用目的：英語の発音チェック機能において音声を認識するために利用します。\n・取り扱い：音声データそのものを本アプリのサーバーへ保存・送信することはありません。認識されたテキスト結果および判定結果のみを学習記録として保存します。" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="4. 外部サービスの利用"
            android:textColor="#212121"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#424242"
            android:text="本アプリは Google Firebase（Auth, Firestore, Cloud Functions, Messaging）を利用してデータの安全な保存と機能提供を行っています。" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="5. データの削除依頼と問い合わせ"
            android:textColor="#212121"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#424242"
            android:text="ユーザーは、本アプリ内の問い合わせ、または以下のメールアドレスよりご自身のデータの削除を依頼することができます。\nお問い合わせ先：studylocking@gmail.com" />

        <View
            android:layout_width="match_parent"
            android:layout_height="48dp" />

    </LinearLayout>
</ScrollView>
