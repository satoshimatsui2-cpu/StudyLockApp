<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:parentTag="android.widget.FrameLayout">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_mastery_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp">

        <!-- レール本体 -->
        <LinearLayout
            android:id="@+id/layout_rail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <View android:id="@+id/node1" android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/shape_mastery_node" />
            <View android:id="@+id/line1" android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="@color/app_outline" />

            <View android:id="@+id/node2" android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/shape_mastery_node" />
            <View android:id="@+id/line2" android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="@color/app_outline" />

            <View android:id="@+id/node3" android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/shape_mastery_node" />
            <View android:id="@+id/line3" android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="@color/app_outline" />

            <View android:id="@+id/node4" android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/shape_mastery_node" />
            <View android:id="@+id/line4" android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" android:background="@color/app_outline" />

            <ImageView
                android:id="@+id/node_goal"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_round_stars_24"
                app:tint="@color/app_outline"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- 現在のLVチップ (動的に移動させる) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_level_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            app:cardBackgroundColor="@color/navy_primary"
            app:cardCornerRadius="4dp"
            app:cardElevation="2dp"
            app:layout_constraintBottom_toTopOf="@id/layout_rail"
            app:layout_constraintStart_toStartOf="parent"
            app:strokeWidth="0dp">
            <TextView
                android:id="@+id/text_level_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="LV4" />
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
