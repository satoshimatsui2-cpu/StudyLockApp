<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- メイン画面・級選択共通ボタンスタイル -->
    <style name="App.MainButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@color/white</item>
        <item name="strokeColor">@color/navy_primary</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:textColor">@color/navy_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconTint">@color/navy_primary</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">24dp</item>
    </style>

    <!-- 履歴ボタン用 (紺色塗りつぶし・白文字) -->
    <style name="App.HistoryButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/navy_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">24dp</item>
    </style>

    <!-- オレンジボタン用 (指定色背景・白文字・紺色太枠) -->
    <style name="App.OrangeButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/brand_orange</item>
        <item name="strokeColor">@color/navy_primary</item>
        <item name="strokeWidth">3dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">24dp</item>
    </style>

    <!-- 学習画面 選択肢ボタン共通スタイル -->
    <style name="Widget.StudyLock.ChoiceButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@color/choice_normal_bg</item>
        <item name="strokeColor">@color/choice_normal_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textColor">@color/choice_normal_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="rippleColor">@color/choice_pressed_bg</item>
        <item name="android:elevation">3dp</item>
        <item name="android:stateListAnimator">@animator/sl_button_elevation_animator</item>
    </style>

    <!-- 補助操作ボタン共通スタイル (白背景・紺枠) -->
    <style name="Widget.StudyLock.AssistButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@color/white</item>
        <item name="strokeColor">@color/navy_primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textColor">@color/navy_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconTint">@color/navy_primary</item>
        <item name="iconPadding">4dp</item>
        <item name="iconSize">18dp</item>
        <item name="rippleColor">@color/navy_soft</item>
    </style>

    <!-- 補助操作 「わからない」ボタン (黄色系) -->
    <style name="Widget.StudyLock.AssistButton.Unknown" parent="Widget.StudyLock.AssistButton">
        <item name="backgroundTint">@color/unknown_bg</item>
        <item name="strokeColor">@color/unknown_stroke</item>
        <item name="android:textColor">@color/unknown_text</item>
        <item name="android:textSize">12sp</item>
        <item name="rippleColor">#F3E3A4</item>
    </style>

    <!-- 右上 設定アイコンボタン用スタイル -->
    <style name="Widget.StudyLock.HeaderIconButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:padding">8dp</item>
        <item name="android:minWidth">52dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="iconTint">@color/navy_primary</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">32dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">@color/navy_soft</item>
    </style>

    <!-- 旧スタイルの互換性維持 -->
    <style name="Widget.StudyLock.UnknownButton" parent="Widget.StudyLock.AssistButton.Unknown" />

    <!-- 回答ボタン共通スタイル (既存互換用) -->
    <style name="App.PrimaryButton" parent="App.MainButton">
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="ChoiceButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:minHeight">88dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:gravity">center</item>
        <item name="android:elevation">4dp</item>
        <item name="backgroundTint">@android:color/white</item>
        <item name="strokeColor">@color/text_link</item>
        <item name="strokeWidth">3dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">12sp</item>
        <item name="autoSizeMaxTextSize">18sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
    </style>

    <!-- ダイアログ共通テーマ (AlertDialog / MaterialAlertDialog 両対応) -->
    <style name="App.AlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <!-- 背景色 (白系) -->
        <item name="colorSurface">@color/dialog_surface</item>
        <!-- タイトル・本文の文字色 (濃い紺色) -->
        <item name="colorOnSurface">@color/text_main</item>
        <item name="colorOnSurfaceVariant">@color/text_sub</item>
        <!-- ボタンの文字色 (メイン紺色) -->
        <item name="colorPrimary">@color/navy_primary</item>

        <!-- Legacy AlertDialog 互換 -->
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="buttonBarPositiveButtonStyle">@style/App.Dialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/App.Dialog.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/App.Dialog.Button</item>
    </style>

    <style name="App.Dialog.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/navy_primary</item>
    </style>
</resources>
